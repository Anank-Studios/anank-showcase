  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.36.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
