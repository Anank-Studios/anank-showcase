# Anank Showcase — variáveis de ambiente
#
# Copie para `.env.local` (na raiz de apps/web) se precisar sobrescrever.
# Nenhuma delas é secreta: o projeto não tem banco, não tem autenticação e não
# integra com serviço externo. A API é inteiramente mockada em memória.

# ---- Frontend (apps/web) ----------------------------------------------------

# De onde o front busca os dados. É a única configuração que o front precisa.
NEXT_PUBLIC_API_URL=http://localhost:3333

# ---- Backend (apps/api) -----------------------------------------------------

# Porta do Fastify.
PORT=3333

# Origem liberada no CORS. Mude se subir o front em outra porta —
# ex.: http://localhost:3100
WEB_ORIGIN=http://localhost:3000

# ---- Ferramentas de QA ------------------------------------------------------

# Base usada por scripts/qa.mjs, scripts/lh.mjs e scripts/keyboard.mjs.
# Útil quando a porta 3000 está ocupada por outro projeto.
QA_BASE_URL=http://localhost:3000

# ---- Deploy (docker-compose.yml, só no servidor) ----------------------------

# Host público lido pelas labels do Traefik. É a ÚNICA variável que o
# `docker compose` exige na raiz do projeto no servidor — em desenvolvimento
# nada aqui é usado.
SHOWCASE_HOST=demo.anankstudios.com.br
